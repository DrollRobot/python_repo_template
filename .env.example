# .env.example

# Which backend to use: keyring | keyvault
# CREDENTIAL_BACKEND=keyring

# Which credential type to use: user_pass | cert_thumbprint | service_principal
# CREDENTIAL_TYPE=user_pass

# --- user_pass ---
# USERNAME_KEY=python_repo_template_username
# PASSWORD_KEY=python_repo_template_password

# --- cert_thumbprint ---
# CERT_THUMBPRINT_KEY=python_repo_template_cert_thumbprint

# --- service_principal ---
# TENANT_ID_KEY=python_repo_template_tenant_id
# CLIENT_ID_KEY=python_repo_template_client_id
# CLIENT_SECRET_KEY=python_repo_template_client_secret

# --- keyvault backend only ---
# KEYVAULT_TENANT_ID=
# KEYVAULT_URL=

# python_repo_template # FIXME remove these first 4 lines
# The .env.example is a template the project consumer can copy to create their own .env file
# This file *should* be committed to the repo, unlike .env

# .env.example

# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env
#   Copy-Item .env.example .env

# A simple string value
APP_NAME=my-app

# A secret key or token (leave blank here to signal it is required)
SECRET_KEY=

# A URL with a default suitable for local development
DATABASE_URL=postgresql://localhost:5432/mydb

# A boolean flag
DEBUG=false

# A numeric setting
PORT=8000
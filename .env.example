# .env.example

# --- Credentials backend ---------------------------------------------------
# Default is keyring (OS credential store, no Azure needed). Flip to keyvault
# to read secrets from Azure KeyVault instead -- no code change -- which also
# needs the KEYVAULT_* vars below and the `keyvault` dependency group.
# CREDENTIAL_BACKEND=keyring

# Which credential type to use: user_pass | cert_thumbprint | service_principal
# CREDENTIAL_TYPE=user_pass

# Key *names* (not the secrets). For the keyring backend, run
#   uv run scripts/setup_credentials.py --type <type>
# once to store the actual secret values under these names.

# --- user_pass ---
# USERNAME_KEY=python_repo_template_username
# PASSWORD_KEY=python_repo_template_password

# --- cert_thumbprint ---
# CERT_THUMBPRINT_KEY=python_repo_template_cert_thumbprint

# --- service_principal ---
# TENANT_ID_KEY=python_repo_template_tenant_id
# CLIENT_ID_KEY=python_repo_template_client_id
# CLIENT_SECRET_KEY=python_repo_template_client_secret

# --- Azure KeyVault only -- delete this block if CREDENTIAL_BACKEND=keyring ---
# KEYVAULT_TENANT_ID=
# KEYVAULT_URL=
